// Shared colors stay legible in both themes.
:root {
  --main-depth: 0 14px 36px rgba(39, 32, 48, .18), 0 3px 10px rgba(39, 32, 48, .1);
  --card-depth: 0 6px 18px rgba(39, 32, 48, .16), 0 2px 5px rgba(39, 32, 48, .09);
  --card-hover-depth: 0 14px 30px rgba(39, 32, 48, .24), 0 4px 10px rgba(39, 32, 48, .12);
  --menu-ink: #333;
  --menu-hover: #f9e4eb;
  --menu-selected: #f4cbd9;
}
:root[data-theme="dark"] {
  --main-depth: 0 14px 36px rgba(0, 0, 0, .48), 0 3px 10px rgba(0, 0, 0, .3);
  --card-depth: 0 6px 18px rgba(0, 0, 0, .4), 0 2px 5px rgba(0, 0, 0, .24);
  --card-hover-depth: 0 14px 30px rgba(0, 0, 0, .58), 0 4px 10px rgba(0, 0, 0, .32);
  --menu-ink: #f3eaf0;
  --menu-hover: #40323d;
  --menu-selected: #654354;
}
#main { box-shadow: var(--main-depth); }
.segments > .item {
  box-shadow: var(--card-depth);
  &:hover, &:focus-within { box-shadow: var(--card-hover-depth); }
}

.social .item.item {
  border-radius: .65rem;
  transition: background-color .18s ease, transform .18s ease;
  &::before { display: none; }
  i, &:focus i {
    color: var(--menu-ink);
    transform: scale(.9);
  }
  &:hover, &:focus-visible {
    background: var(--menu-hover);
    i { color: var(--menu-ink); transform: scale(1); }
  }
  &:focus-visible { outline: 2px solid var(--color-aqua); outline-offset: 3px; }
}

:root[data-theme="dark"] .social .item.item:hover,
:root[data-theme="dark"] .social .item.item:focus-visible { background: #70485e; }

.overview .menu {
  .item {
    color: var(--menu-ink);
    border-radius: .75rem;
    transition: background-color .18s ease, color .18s ease;
    &:hover, &:focus-within, &.expand { background: var(--menu-hover); color: var(--menu-ink); }
    &.active, &.active:hover {
      background: var(--menu-selected);
      color: var(--menu-ink);
      box-shadow: none;
    }
    a:focus-visible { outline: 2px solid var(--color-aqua); border-radius: .75rem; }
  }

}

.overview .author { padding-top: .75rem; }
.overview .author .image { max-width: 9rem; }
:root[data-theme="dark"] .overview .author .image {
  content: url('/assets/Z1gg7x_SilverDragon_Blue_512.webp');
}
:root[data-theme="dark"] .overview .author .name { margin-top: .75rem; }
#sidebar.menu-visible #quick { display: flex; }
#sidebar:not(.affix):not(.on) #quick { position: static; }
.social .item.unlinked:hover i { animation: unavailable-shake .45s ease infinite; }
@keyframes unavailable-shake {
  25%, 75% { transform: rotate(-12deg); }
  50% { transform: rotate(12deg); }
}
.unavailable-message {
  position: fixed;
  z-index: 9999;
  pointer-events: none;
  color: #c74d7f;
  font-family: "Hannotate SC", "HanziPen SC", "YouYuan", cursive;
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.5;
  padding: .5rem .75rem;
}
:root[data-theme="dark"] .unavailable-message { color: #f4aac7; }
.unavailable-dust { position: fixed; z-index: 9999; pointer-events: none; }
.overview .menu { padding: .5rem; }
#sidebar.affix .panels > .inner { margin-top: 0; }
#sidebar #quick.menu-clipped { visibility: hidden; pointer-events: none; }
#sidebar.affix .panels, #sidebar.on .panels { padding-bottom: 3rem; }
.overview .author .name a {
  color: inherit;
  &:hover { color: var(--color-aqua); }
}

#comments, #new-comment { scroll-margin-top: 5rem; }
#tool .chat[hidden] { display: none; }

#local-search {
  margin: auto;
  inset: 0;
  width: 42rem;
  max-width: calc(100vw - 2rem);
  max-height: 80vh;
  padding: 1.25rem;
  border: 1px solid var(--grey-3);
  border-radius: 1rem;
  background: var(--grey-1);
  color: var(--menu-ink);
  box-shadow: 0 1rem 4rem rgba(0,0,0,.2);
  &::backdrop { background: rgba(0,0,0,.45); backdrop-filter: blur(4px); }
  .search-header { display: flex; gap: .75rem; align-items: center; margin-bottom: 1rem; }
  input {
    flex: 1;
    min-width: 0;
    padding: .7rem;
    background: var(--grey-2);
    color: inherit;
    border: 1px solid var(--grey-4);
    border-radius: .5rem;
  }
  button { color: inherit; background: var(--menu-hover); border: 0; border-radius: .5rem; padding: .5rem .75rem; cursor: pointer; }
  ul { padding: 0; list-style: none; }
  li { border-top: 1px solid var(--grey-3); padding: .8rem 0; }
  a { color: var(--color-aqua); font-weight: 600; }
  p { margin: .5rem 0; font-size: .9rem; }
}
@media (prefers-reduced-motion: reduce) {
  .social .item.unlinked:hover i { animation: none; }
  .overview .menu .item.dropdown > .submenu,
  .social .item, .social .item i { transition: none; }
}

@media (min-width: 992px) {
  #sidebar { align-self: stretch; transition: none; }
  #sidebar > .inner, #sidebar.affix > .inner {
    position: relative;
    top: auto;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
  }
  #sidebar .panels, #sidebar.affix .panels {
    padding: 1.5rem 0 0;
    height: auto;
    min-height: 0;
    width: 100%;
  }
  #sidebar .panels > .inner { margin-top: 0; height: auto; overflow-y: visible; }
  #sidebar:has(.tab) .panels { padding-top: 4.6875rem; }
  #sidebar.desktop-docked:has(.tab) .panels { padding-top: 3.625rem; }
  #sidebar #quick {
    display: flex;
    position: static;
    height: 40px;
    flex-shrink: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .2s ease, visibility .2s;
  }
  #sidebar.desktop-docked > .inner { position: fixed; top: 0; }
  #sidebar.desktop-docked .panels { flex: 1; }
  #sidebar.desktop-docked .panels > .inner { height: 100%; overflow-y: auto; }
  #sidebar.desktop-docked #quick { opacity: 1; visibility: visible; pointer-events: auto; }
}

.friend-application {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
  margin: 0;
  .friend-box { min-width: 0; padding: 2rem; box-shadow: var(--main-depth); background: var(--grey-1); border: 1px solid var(--grey-3); border-radius: 1.25rem; }
  h2 { margin: 0 0 1rem; }
  h3 { margin: 0 0 .5rem; font-size: 1rem; }
  p { margin: .5rem 0; color: var(--grey-6); }
  .friend-profile { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .friend-profile img { width: 80px; height: 80px; object-fit: cover; border-radius: 1rem; margin: 0; }
  .friend-profile h2 { font-size: 1.4rem; margin: 0; }
  .friend-field, .friend-template { position: relative; background: var(--grey-2); border-radius: .875rem; padding: 1rem; margin: .75rem 0; }
  .friend-field span { display: block; color: var(--grey-5); font-size: .85rem; }
  .friend-field strong { display: block; padding-right: 3.5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  button { background: var(--grey-3); color: var(--primary-color); border: 0; border-radius: .5rem; padding: .4rem .6rem; cursor: pointer; }
  .friend-field button { position: absolute; right: .75rem; top: 50%; transform: translateY(-50%); }
  .friend-template pre { background: none; padding: 0; margin: 0 0 .75rem; white-space: pre-wrap; }
  .friend-steps { padding: 0; list-style: none; }
  .friend-steps li { position: relative; padding: 0 0 1.5rem 2.75rem; border: 0; }
  .friend-steps li:not(:last-child)::after { content: ""; position: absolute; left: 1rem; top: 2.5rem; bottom: .5rem; width: 2px; background: var(--grey-3); }
  .friend-steps li::before { content: attr(data-step); position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; line-height: 2rem; text-align: center; background: var(--primary-color); color: white; border-radius: 50%; }
}
@media (max-width: 767px) {
  .friend-application { grid-template-columns: minmax(0, 1fr); }
}

/* Dedicated friend-page modules; regular article templates retain their footer. */
#main:has(.friend-module) {
  background: none;
  box-shadow: none;
  .friend-links { background: var(--grey-1); border-radius: 1rem; box-shadow: var(--main-depth); }
  .friend-module { padding: 0; margin: 1.5rem 0; }
