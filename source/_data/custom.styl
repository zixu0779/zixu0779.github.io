.about-map { display: block; width: 100%; height: 180px; border: 0; border-radius: .5rem; margin-bottom: .5rem; }

// 归档时间线沿用 Astro 的布局。
/* Timeline styles for categories/archives - migrated from old_project */

.timeline {
  position: relative;
}

.timeline small {
  color: var(--grey-5);
  margin: auto 0.3125rem;
}

.timeline .item {
  position: relative;
  padding: 1.25rem 1.875rem;
  margin: 0;
}

.timeline .item::before {
  content: "";
  position: absolute;
  z-index: 1;
  transition: all 0.4s ease-in-out;
  box-sizing: unset;
  top: 1.9rem;
  left: 0;
  width: 0.6rem;
  height: 0.6rem;
  border: 0.15rem solid var(--primary-color);
  border-radius: 50%;
  background: var(--grey-1);
}

.timeline .item:not(:last-child):not(.title)::after {
  content: "";
  position: absolute;
  top: 1.9rem;
  bottom: -1.9rem;
  left: 0.35rem;
  border-left: 0.2rem solid var(--color-red-a3);
}

.timeline .item:hover::before {
  border-color: var(--color-blue);
}

/* Header item styles */
.timeline .item.header::after {
  border-left-style: dashed !important;
}

.timeline .item.header .cheers {
  display: block;
}

/* Section item styles */
.timeline .item.section::before {
  width: 0.4rem;
  height: 0.4rem;
  margin-left: 0.1rem;
}

/* Link styles for title, header, section */
.timeline .item.title a,
.timeline .item.header a,
.timeline .item.section a {
  border-bottom: 0.0625rem dashed var(--grey-5);
  color: var(--primary-color);
  text-decoration: none;
  transition: all 0.3s ease;
}

.timeline .item.title:hover a,
.timeline .item.header:hover a,
.timeline .item.section:hover a {
  border-bottom-color: var(--color-blue);
  color: var(--color-blue);
}

/* Normal item styles */
.timeline .item.normal {
  display: flex;
  flex-wrap: nowrap;
  align-items: baseline;
  padding: 0.625rem 1.875rem;
}

.timeline .item.normal::before {
  top: 1.4rem;
  width: 0.2rem;
  height: 0.2rem;
  margin-left: 0.2rem;
  background: var(--primary-color);
}

.timeline .item.normal:hover::before {
  background: var(--color-blue);
}

.timeline .item.normal .meta {
  flex-shrink: 0;
  display: inline;
  font-size: 0.75rem;
  margin-right: 0.625rem;
}

.timeline .item.normal .meta time {
  color: var(--grey-5);
}

.timeline .item.normal .title {
  line-height: 1.5;
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.timeline .item.normal .title a {
  color: var(--primary-color);
  text-decoration: none;
  transition: color 0.3s ease;
}

.timeline .item.normal .title a:hover {
  color: var(--color-blue);
}

.timeline .item.normal .title .i-link-alt,
.timeline .item.normal .title .i-ri-external-link-line {
  font-size: 0.875rem;
  margin-left: 0.3125rem;
}

/* External link styles */
.timeline .item.normal .title a.external {
  display: inline-flex;
  align-items: center;
}

/* Responsive styles */
@media (max-width: 768px) {
  .timeline .item {
    padding: 1rem 1.25rem;
  }

  .timeline .item.normal {
    padding: 0.5rem 1.25rem;
  }

  .timeline .item::before {
    top: 1.6rem;
  }

  .timeline .item.normal::before {
    top: 1.2rem;
  }
}

@media (max-width: 480px) {
  .timeline .item {
    padding: 0.75rem 1rem;
  }

  .timeline .item.normal {
    padding: 0.375rem 1rem;
  }
}

.astro-archive.wrap { max-width: 60rem; margin: 0 auto; padding: 2rem 1rem; }
.timeline .item.header, .taxonomy-overview .item.header { font-size: 1rem; line-height: 1.5; font-weight: 400; font-family: inherit; }
.timeline .item.section, .taxonomy-overview .item.section { font-size: 1.125rem; line-height: 1.5; font-family: inherit; }
