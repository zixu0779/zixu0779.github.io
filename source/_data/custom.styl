// Shared colors stay legible in both themes.
:root {
  --main-depth: 0 14px 36px rgba(39, 32, 48, .18), 0 3px 10px rgba(39, 32, 48, .1);
  --card-depth: 0 6px 18px rgba(39, 32, 48, .16), 0 2px 5px rgba(39, 32, 48, .09);
  --card-hover-depth: 0 14px 30px rgba(39, 32, 48, .24), 0 4px 10px rgba(39, 32, 48, .12);
  --menu-ink: #333;
  --menu-hover: #f9e4eb;
  --menu-selected: #f4cbd9;
}
:root[data-theme="dark"] {
  --main-depth: 0 14px 36px rgba(0, 0, 0, .48), 0 3px 10px rgba(0, 0, 0, .3);
  --card-depth: 0 6px 18px rgba(0, 0, 0, .4), 0 2px 5px rgba(0, 0, 0, .24);
  --card-hover-depth: 0 14px 30px rgba(0, 0, 0, .58), 0 4px 10px rgba(0, 0, 0, .32);
  --menu-ink: #f3eaf0;
  --menu-hover: #40323d;
  --menu-selected: #654354;
}

.social .item.item {
  border-radius: .65rem;
  transition: background-color .18s ease, transform .18s ease;
  &::before { display: none; }
  i, &:focus i {
    color: var(--menu-ink);
    transform: scale(.9);
  }
  &:hover, &:focus-visible {
    background: var(--menu-hover);
    i { color: var(--menu-ink); transform: scale(1); }
  }
  &:focus-visible { outline: 2px solid var(--color-aqua); outline-offset: 3px; }
}

:root[data-theme="dark"] .social .item.item:hover,
:root[data-theme="dark"] .social .item.item:focus-visible { background: #70485e; }

.overview .menu {
  .item {
    color: var(--menu-ink);
    border-radius: .75rem;
    transition: background-color .18s ease, color .18s ease;
    &:hover, &:focus-within, &.expand { background: var(--menu-hover); color: var(--menu-ink); }
    &.active, &.active:hover {
      background: var(--menu-selected);
      color: var(--menu-ink);
      box-shadow: none;
    }
    a:focus-visible { outline: 2px solid var(--color-aqua); border-radius: .75rem; }
  }

}

.overview .author { padding-top: .75rem; }
.overview .author .image { max-width: 9rem; }
:root[data-theme="dark"] .overview .author .name { margin-top: .75rem; }
#sidebar.menu-visible #quick { display: flex; }
#sidebar:not(.affix):not(.on) #quick { position: static; }
.social .item.unlinked:hover i { animation: unavailable-shake .45s ease infinite; }
.unavailable-message {
  position: fixed;
  z-index: 9999;
  pointer-events: none;
  color: #c74d7f;
  font-family: "Hannotate SC", "HanziPen SC", "YouYuan", cursive;
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.5;
  padding: .5rem .75rem;
}
:root[data-theme="dark"] .unavailable-message { color: #f4aac7; }
.unavailable-dust { position: fixed; z-index: 9999; pointer-events: none; }
.overview .menu { padding: .5rem; }
#sidebar.affix .panels > .inner { margin-top: 0; }
#sidebar #quick.menu-clipped { visibility: hidden; pointer-events: none; }
#sidebar.affix .panels, #sidebar.on .panels { padding-bottom: 3rem; }
.overview .author .name a {
  color: inherit;
  &:hover { color: var(--color-aqua); }
}

#local-search {
  margin: auto;
  inset: 0;
  width: 42rem;
  max-width: calc(100vw - 2rem);
  max-height: 80vh;
  padding: 1.25rem;
  border: 1px solid var(--grey-3);
  border-radius: 1rem;
  background: var(--grey-1);
  color: var(--menu-ink);
  box-shadow: 0 1rem 4rem rgba(0,0,0,.2);
  &::backdrop { background: rgba(0,0,0,.45); backdrop-filter: blur(4px); }
  .search-header { display: flex; gap: .75rem; align-items: center; margin-bottom: 1rem; }
  input {
    flex: 1;
    min-width: 0;
    padding: .7rem;
    background: var(--grey-2);
    color: inherit;
    border: 1px solid var(--grey-4);
    border-radius: .5rem;
  }
  button { color: inherit; background: var(--menu-hover); border: 0; border-radius: .5rem; padding: .5rem .75rem; cursor: pointer; }
  ul { padding: 0; list-style: none; }
  li { border-top: 1px solid var(--grey-3); padding: .8rem 0; }
  a { color: var(--color-aqua); font-weight: 600; }
  p { margin: .5rem 0; font-size: .9rem; }
}
@media (prefers-reduced-motion: reduce) {
  .social .item.unlinked:hover i { animation: none; }
  .overview .menu .item.dropdown > .submenu,
  .social .item, .social .item i { transition: none; }
}

@media (min-width: 992px) {
  #sidebar { align-self: stretch; transition: none; }
  #sidebar > .inner, #sidebar.affix > .inner {
    position: relative;
    top: auto;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
  }
  #sidebar .panels, #sidebar.affix .panels {
    padding: 1.5rem 0 0;
    height: auto;
    min-height: 0;
    width: 100%;
  }
  #sidebar .panels > .inner { margin-top: 0; height: auto; overflow-y: visible; }
  #sidebar:has(.tab) .panels { padding-top: 4.6875rem; }
  #sidebar.desktop-docked:has(.tab) .panels { padding-top: 3.625rem; }
  #sidebar #quick {
    display: flex;
    position: static;
    height: 40px;
    flex-shrink: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .2s ease, visibility .2s;
  }
  #sidebar.desktop-docked > .inner { position: fixed; top: 0; }
  #sidebar.desktop-docked .panels { flex: 1; }
  #sidebar.desktop-docked .panels > .inner { height: 100%; overflow-y: auto; }
  #sidebar.desktop-docked #quick { opacity: 1; visibility: visible; pointer-events: auto; }
}

.unavailable-message { white-space: nowrap; width: max-content; max-width: none; }
#sidebar .overview .menu { padding: 1.25rem; }
#sidebar .overview .menu .item { background: transparent; box-shadow: none; transition: none; }
#sidebar .overview .menu .item > a { border-radius: .75rem; transition: background-color .2s ease, color .2s ease; background: transparent; color: var(--menu-ink); }
#sidebar .overview .menu .item > a:hover, #sidebar .overview .menu .item > a:focus-visible { background: var(--menu-hover); }
#sidebar .overview .menu .item.active > a { background: var(--menu-selected); color: var(--menu-ink); box-shadow: none; }
@media(min-width:992px) { :root[data-theme="dark"] #sidebar .panels > .inner { padding-top: .75rem; } }

@media(min-width:992px) { #sidebar .overview .menu .item > a { max-width: 9.625rem; margin: 0 auto; } }

// No clipping or internal scroll when the sidebar fits the viewport.
@media(min-width:992px) {
  #sidebar .panels, #sidebar.desktop-docked .panels { overflow: visible; min-height: 0; }
  #sidebar .panels > .inner, #sidebar.desktop-docked .panels > .inner { height: auto; overflow: visible; padding: 0; }
  :root[data-theme="dark"] #sidebar .panels > .inner { padding-top: 0; }
  :root[data-theme="dark"] #sidebar .panels { padding-top: 2.25rem; }
}

/* Sidebar children occupy separate rows; no absolute tab or spacer padding. */
@media(min-width:992px) {
  #sidebar .tab, #sidebar.affix .tab { position: static; order: -1; flex-shrink: 0; align-self: center; padding: 0 0 .625rem; }
  #sidebar .panels, #sidebar.affix .panels, #sidebar:has(.tab) .panels, #sidebar.desktop-docked:has(.tab) .panels,
  :root[data-theme="dark"] #sidebar .panels { padding: 0; }
  #sidebar .panels .panel { padding-top: 0; padding-bottom: 0; }
  #sidebar .panels > .inner { padding-top: 0; }
  #sidebar #quick { margin-top: auto; }
}
@media(min-width:992px) {
  /* Keep a small panels inset while tabs occupy their own row. */
  #sidebar .panels { padding-top: .625rem !important; }
}

:root { --site-accent: #d47e9a; }
@media(min-width:992px) {
  #sidebar > .inner { padding-top: 2rem; box-sizing: border-box; }
}
#sidebar #quick li.percent { display: none; }

/* Sidebar scrollbars use one scoped style in both overview and article panels. */
#sidebar .panels > .inner {
  scrollbar-width: auto;
  scrollbar-color: auto;
}
#sidebar .panels > .inner::-webkit-scrollbar { display: block; width: 6px; height: 6px; background: transparent; }
#sidebar .panels > .inner::-webkit-scrollbar-track { background: transparent; }
#sidebar .panels > .inner::-webkit-scrollbar-thumb { background: var(--site-accent); border: 0; border-radius: 6px; }

#sidebar .overview .menu { padding: .375rem 1.25rem 0; }
#sidebar .overview .menu .item:last-child { margin-bottom: 0; }
#sidebar .overview .menu .item.active,
#sidebar .overview .menu .item.active:hover { background: transparent; box-shadow: none; }
#sidebar .overview .menu .item > a { border-radius: .9375rem; }
#sidebar .overview .menu .item:not(.active) > a:hover,
#sidebar .overview .menu .item:not(.active) > a:focus-visible { background: var(--menu-selected); }
#sidebar .overview .menu .item.active > a,
#sidebar .overview .menu .item.active > a:hover {
  background: linear-gradient(to right, var(--color-pink), var(--color-orange));
  color: #fff;
  box-shadow: none;
}

/* Extend the scroll viewport into existing top space without moving its contents. */
@media(min-width:992px) {
  #sidebar .panels > .inner, #sidebar.affix .panels > .inner, #sidebar.desktop-docked .panels > .inner,
  :root[data-theme="dark"] #sidebar .panels > .inner {
    padding-top: 2rem;
    margin-top: -2rem;
    box-sizing: border-box;
  }
  #sidebar .tab { position: relative; z-index: 2; }
}

#sidebar .overview .menu[data-hover-ready] { position: relative; isolation: isolate; }
#sidebar .overview .menu[data-hover-ready]::before {
  content: ''; position: absolute; left: var(--hover-x, 20px); top: 0;
  width: var(--hover-w, 9.625rem); height: var(--hover-h, 3rem);
  transform: translateY(var(--hover-y, 0px)); border-radius: .9375rem;
  background: var(--menu-selected); opacity: 0; pointer-events: none;
  transition: transform .16s ease, opacity .12s ease;
}
#sidebar .overview .menu.hover-visible::before { opacity: 1; }
#sidebar .overview .menu[data-hover-ready] .item { background: transparent; box-shadow: none; }
#sidebar .overview .menu[data-hover-ready] .item > a { position: relative; z-index: 1; transition: color .16s ease; }
#sidebar .overview .menu[data-hover-ready] .item:not(.active) > a:hover,
#sidebar .overview .menu[data-hover-ready] .item:not(.active) > a:focus-visible { background: transparent; }
#sidebar .overview .menu[data-hover-ready] .item.active > a { transition: box-shadow .2s ease-in-out; }
#sidebar .overview .menu[data-hover-ready] .item.active > a:hover,
#sidebar .overview .menu[data-hover-ready] .item.active > a:focus-visible { box-shadow: 0 0 .75rem var(--color-pink); }
