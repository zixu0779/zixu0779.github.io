}
main:has(.friend-module) { background: var(--body-bg-shadow); }
#main .friend-comment-anchor { height: 1px; padding: 0; margin: 0; border: 0; background: none; box-shadow: none; overflow: hidden; }
main:has(.friend-module) #quick .percent { display: none; }
.friend-application {
  h2, h3 { border: 0; padding: 0; color: var(--grey-7); font-family: inherit; font-weight: 700; }
  h2 .ic { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border-radius: .75rem; margin-right: .75rem; color: var(--primary-color); background: var(--grey-2); }
  .friend-steps { margin: 1.5rem 0 0; }
