}

@media (min-width: 1024px) {
  .about-page .body.md { box-sizing: border-box; max-width: min(40rem, 50vw); }
}

.unavailable-message { white-space: nowrap; width: max-content; max-width: none; }
.about-extras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.about-extra { padding: 1rem; border: 1px solid var(--grey-3); border-radius: .75rem; background: var(--grey-2); }
