#container:not(:has(.friend-module)) #footer { background: var(--grey-2); }
#quick .percent { display: none; }
#sidebar #quick li.percent { display: none; }
#container:not(:has(.friend-module)) #footer .widgets { background: transparent; }

/* Preserve the deployed native scrollbar appearance; blend tracks into the page. */
html { --scrollbar-thumb: #b47790; }
:root[data-theme="dark"] { --scrollbar-thumb: #897383; }
html, body.loaded {
  scrollbar-width: auto;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}
/* Fallback for browsers without scrollbar-color. */
html, body.loaded {
  &::-webkit-scrollbar { display: block; width: 10px; height: 10px; background: transparent; }
  &::-webkit-scrollbar-track { background: transparent; }
  &::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
    background-clip: padding-box;
    border: 2px solid transparent;
    border-radius: 8px;
  }
}
#sidebar .panels > .inner { scrollbar-width: none; }
#sidebar .panels > .inner::-webkit-scrollbar { display: none; }
@media(min-width:992px) and (max-height:680px) {
  #sidebar .overview .menu .item:not(:last-child) { margin-bottom: .375rem; }
}

#sidebar .overview .menu { padding: .375rem 1.25rem 0; }
#sidebar .overview .menu .item:last-child { margin-bottom: 0; }
#sidebar .overview .menu .item.active,
#sidebar .overview .menu .item.active:hover { background: transparent; box-shadow: none; }
#sidebar .overview .menu .item > a { border-radius: .9375rem; }
#sidebar .overview .menu .item:not(.active) > a:hover,
#sidebar .overview .menu .item:not(.active) > a:focus-visible { background: var(--menu-selected); }
#sidebar .overview .menu .item.active > a,
#sidebar .overview .menu .item.active > a:hover {
  background: linear-gradient(to right, var(--color-pink), var(--color-orange));
  color: #fff;
  box-shadow: none;
}

#tool#tool, #tool#tool .item, #tool#tool .ic, #tool#tool button {
  color: var(--site-accent);
  text-shadow: none;
  filter: none;
}

/* Extend the scroll viewport into existing top space without moving its contents. */
@media(min-width:992px) {
  #sidebar .panels > .inner, #sidebar.affix .panels > .inner, #sidebar.desktop-docked .panels > .inner,
  :root[data-theme="dark"] #sidebar .panels > .inner {
    padding-top: 2rem;
    margin-top: -2rem;
    box-sizing: border-box;
  }
  #sidebar .tab { position: relative; z-index: 2; }
  /* Let content pass behind the individual floating buttons, including their gaps. */
  #sidebar:has(.tab) .panels > .inner,
  :root[data-theme="dark"] #sidebar:has(.tab) .panels > .inner {
    padding-top: 3.625rem;
    margin-top: -3.625rem;
  }
  #sidebar .tab { background: transparent; box-shadow: none; pointer-events: none; }
  #sidebar .tab .item { pointer-events: auto; background-color: var(--grey-3); }
}


/* Only cards touching the cover have square top corners. */
#main:not(:has(.friend-module)):not(:has(.about-page)),
#main .friend-links,
#main .about-body { border-radius: 0 0 1rem 1rem; }

#sidebar .overview .menu[data-hover-ready] { position: relative; isolation: isolate; }
#sidebar .overview .menu[data-hover-ready]::before {
  content: ''; position: absolute; left: var(--hover-x, 20px); top: 0;
  width: var(--hover-w, 9.625rem); height: var(--hover-h, 3rem);
  transform: translateY(var(--hover-y, 0px)); border-radius: .9375rem;
  background: var(--menu-selected); opacity: 0; pointer-events: none;
  transition: transform .16s ease, opacity .12s ease;
}
#sidebar .overview .menu.hover-visible::before { opacity: 1; }
#sidebar .overview .menu[data-hover-ready] .item { background: transparent; box-shadow: none; }
#sidebar .overview .menu[data-hover-ready] .item > a { position: relative; z-index: 1; transition: color .16s ease; }
#sidebar .overview .menu[data-hover-ready] .item:not(.active) > a:hover,
#sidebar .overview .menu[data-hover-ready] .item:not(.active) > a:focus-visible { background: transparent; }

.links .image { position: relative; }
.links .image .avatar-initial { position: absolute; inset: 0; display: grid; place-items: center; font-size: 1.4rem; font-weight: 700; color: white; }
.links .image.avatar-placeholder { background: var(--block-color, #666); }
.links .image img { position: relative; z-index: 1; opacity: 0; transition: opacity .2s ease; }
.links .image img.avatar-loaded { opacity: 1; }
.links .image:not(.avatar-placeholder) .avatar-initial { opacity: 0; }


.friend-steps .friend-note { margin-top: -.35rem; }

#main:has(.about-page) { background: none; box-shadow: none; margin-bottom: 0; }
.about-page .about-body, .about-page #comments { background: var(--grey-1); box-shadow: var(--main-depth); }
.about-page .about-modules { margin: 1.5rem 0; }
.about-page #comments { border-radius: 1rem; margin-bottom: 2.5rem; }
.about-page .wl-reaction { display: none; }
.about-support { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--grey-3); }
.about-support .reward { margin: 0; }
.about-page .about-extras { gap: 1.5rem; }
.about-page .about-extra { position: relative; padding: 0; min-height: 320px; border-radius: 1rem; overflow: hidden; background: var(--grey-1); box-shadow: var(--main-depth); }
.about-extra header { padding: 1.25rem 1.5rem .75rem; }
.about-extra header span { color: var(--grey-5); font-size: .8rem; }
.about-extra header h2 { margin: .25rem 0; border: 0; padding: 0; color: var(--grey-7); }
.about-extra .about-map { height: 200px; margin: 0; border-radius: 0; }
.about-extra > a { display: block; padding: .75rem 1.5rem; color: var(--primary-color); font-size: .9rem; }
.about-personality { text-align: center; background: linear-gradient(135deg, var(--grey-1), var(--menu-hover)) !important; }
.about-personality .personality-symbol { display: grid; place-items: center; width: 5rem; height: 5rem; margin: 1rem auto; border: 2px solid var(--primary-color); border-radius: 50%; color: var(--primary-color); font: 500 3rem/1 sans-serif; }
.about-personality p { margin: .5rem 0; color: var(--grey-5); }
@media(max-width:991px) { .about-page .about-extras { grid-template-columns: 1fr; } }

@media(prefers-reduced-motion:reduce) { #sidebar .overview .menu[data-hover-ready]::before, .links .image img { transition: none; } }
#main:has(.friend-module) .friend-links { border-radius: 0 0 1rem 1rem; }
.about-extra header h2 { font-family: inherit; font-size: 1.4rem; font-weight: 600; line-height: 1.5; }

/* One shared article row and marker style for archive and category pages. */
.category-directory > section { position: relative; }
.category-directory > section::before, .category-directory > section::after {
  content: ''; position: absolute; left: .35rem; pointer-events: none;
  border-left: .2rem solid var(--color-red-a3);
}
.category-directory > section::before { top: var(--line-solid); height: calc(var(--line-end) - var(--line-solid)); }
.category-directory > section::after { top: var(--line-start); height: calc(var(--line-solid) - var(--line-start)); border-left-style: dashed; }
.category-directory .item::after { display: none; }
.category-directory .category-parent.item { color: var(--primary-color); font-size: 1.2rem; font-weight: 600; }
.category-directory summary { background: transparent !important; border-radius: 0; transition: color .2s ease; cursor: pointer; list-style: none; color: var(--primary-color); }
.category-directory summary::-webkit-details-marker { display: none; }
.category-directory .category-name { border-bottom: 1px dashed var(--grey-5); transition: color .2s ease, border-color .2s ease; }
.category-directory summary:hover .category-name, .category-directory summary:focus-visible .category-name { color: var(--color-blue); border-color: var(--color-blue); }
.category-directory summary:focus-visible { outline: 2px solid var(--color-aqua); outline-offset: -2px; }
.category-directory .category-posts { margin: 0; padding: 0; animation: none; }
.category-directory .item.normal[hidden] { display: none; }
.category-directory .category-content .pagination[hidden] { display: none; }
#tool#tool .back-to-top > span:not(.page-scroll-progress) { display: none; }
#sidebar .overview .menu[data-hover-ready] .item.active > a { transition: box-shadow .2s ease-in-out; }
#sidebar .overview .menu[data-hover-ready] .item.active > a:hover,
#sidebar .overview .menu[data-hover-ready] .item.active > a:focus-visible { box-shadow: 0 0 .75rem var(--color-pink); }
.links .item .image.avatar-placeholder, .links .item:hover .image.avatar-placeholder { background: var(--block-color, #666); box-shadow: inset 0 0 0 2px var(--grey-1); transition: none; }
.links .item .image .avatar-initial, .links .item:hover .image .avatar-initial { color: white; transition: none; }

/* Keep expansion and pagination height changes on the same content wrapper. */
.category-directory { overflow-anchor: none; }
.category-group, .category-parent { scroll-margin-top: 5rem; }
.category-directory .category-content { padding: 0; margin: 0; overflow: hidden; animation: none; }
/* Reserve arrow space independently of the left-aligned number group. */
.category-directory .pagination .inner { display: inline-block; position: relative; }
.category-directory .pagination .inner > .prev, .category-directory .pagination .inner > .next { position: absolute; top: 0; margin: 0; }
.category-directory .pagination .inner > .prev { right: 100%; }
.category-directory .pagination .inner > .next { left: 100%; }
.category-directory .category-content .pagination { display: block; padding: .35rem 1.875rem; margin: 0; text-align: left; }
.category-directory .pagination .inner { margin-left: 2.5rem; }
.category-directory .pagination .inner > .prev, .category-directory .pagination .inner > .next { width: 2.5rem; padding: 0; text-align: center; }
.nyx-player.panel, .nyx-player.nyx-minibar { right: 4.5rem !important; max-width: calc(100vw - 5.5rem); }
.nyx-player.panel {
  max-height: calc(100dvh - 2rem); overflow-y: auto;
  background: rgba(255, 252, 253, .96); border: 1px solid rgba(155, 110, 130, .25);
  box-shadow: 0 12px 36px rgba(48, 32, 42, .2), 0 2px 8px rgba(48, 32, 42, .1);
  backdrop-filter: blur(16px);
}
:root[data-theme="dark"] .nyx-player.panel {
  background: rgba(44, 47, 58, .97); border-color: rgba(185, 197, 220, .3);
  box-shadow: 0 14px 40px rgba(0, 0, 0, .48), 0 2px 8px rgba(0, 0, 0, .24);
}
@media(min-width:1024px) {
  .about-page .body.md { max-width: none; }
  .about-page .body.md > p, .about-page .body.md > ul { max-width: min(40rem, 50vw); }
}

#footer .count { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; column-gap: .4rem; row-gap: .25rem; }
#footer .count .footer-stat { display: inline-flex; align-items: center; gap: .25rem; white-space: nowrap; }
#footer .count .stat-icon { display: inline-flex; justify-content: center; align-items: center; width: 1.1em; height: 1.1em; flex: 0 0 1.1em; }
#footer .count .stat-icon .ic { font-size: inherit; line-height: 1; }
#footer .count .stat-icon svg { display: block; width: 100%; height: 100%; }
#footer .count .post-meta-divider { margin: 0; }
.md img[width][height] { height: auto; }

/* Keep screenshot geometry identical before and after lazy image decoding. */
.post .md img[style*="--article-image-width"]:not(.emoji):not(.vemoji):not(.links img):not(.gallery img) {
  width: unquote('min(100%, var(--article-image-width))');
  height: auto;
  aspect-ratio: var(--article-image-ratio);
  object-fit: contain;
}

// Cover delivery changes only; the original card geometry and slideshow animation remain.
.cards .cover > img.optimized-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -1;
}
#imgs .optimized-hero:not(.ready) > .item {
  animation: none;
  opacity: 0;
}
#imgs .optimized-hero:not(.ready) > .item:first-child {
  opacity: 1;
}

/* Drawer panels share one bounded scroll area at the theme tablet breakpoint. */
@media(max-width:991px) {
  #sidebar > .inner, #sidebar.affix > .inner {
    height: 100dvh; display: flex; flex-direction: column; flex-wrap: nowrap; justify-content: flex-start;
  }
  #sidebar .tab, #sidebar.affix .tab { position: static; flex-shrink: 0; padding: 1rem 0 .625rem; align-self: center; }
  #sidebar .panels, #sidebar.affix .panels, #sidebar.on .panels {
    flex: 1; min-height: 0; height: auto; padding: 0; overflow: hidden;
  }
  #sidebar .panels .panel { padding-bottom: .5rem; }
  #sidebar .panels > .inner { height: 100%; margin: 0; overflow-y: auto; overscroll-behavior: contain; }
  #sidebar #quick { position: static; flex-shrink: 0; padding-bottom: env(safe-area-inset-bottom); }
}

/* Mobile tools expand upward from a compact, consistently outlined control. */
#tool#tool .tool-toggle { display: none; }
@media(max-width:991px) {
  :root { --mobile-tool-width: 42px; --tool-button-size: 34px; }
  #tool#tool {
    right: unquote('max(.5rem, env(safe-area-inset-right))');
    bottom: unquote('max(.75rem, env(safe-area-inset-bottom))');
    width: var(--mobile-tool-width); padding: 3px; gap: 0; align-items: center; border-radius: .8rem;
    border-color: rgba(90, 100, 120, .32); background: rgba(255, 255, 255, .94);
    box-shadow: 0 4px 18px rgba(35, 45, 65, .15);
  }
  :root[data-theme="dark"] #tool#tool {
    background: rgba(35, 38, 47, .94); border-color: rgba(200, 210, 230, .26);
    box-shadow: 0 4px 18px rgba(0, 0, 0, .28);
  }
  #tool#tool > :not(.tool-toggle):not(.player), #tool#tool .player button {
    max-height: 0; opacity: 0; overflow: hidden; visibility: hidden;
    transform: translateY(8px) scale(.92); pointer-events: none;
    transition: max-height .3s cubic-bezier(.22, 1, .36, 1), opacity .18s ease, transform .3s ease, visibility .3s;
  }
  #tool#tool.mobile-open > :not(.tool-toggle):not(.player), #tool#tool.mobile-open .player button {
    max-height: 64px; opacity: 1; visibility: visible; transform: none; pointer-events: auto;
  }
  #tool#tool .tool-toggle {
    display: flex; align-items: center; justify-content: center;
    width: var(--tool-button-size); height: var(--tool-button-size); padding: 0; flex-shrink: 0; font-size: 1.5rem; line-height: 1; border-radius: .625rem;
    transition: transform .3s cubic-bezier(.22, 1, .36, 1), background-color .2s;
  }
  #tool#tool.mobile-open .tool-toggle { transform: rotate(90deg); }
  #tool#tool button, #tool#tool .chat, #tool#tool .back-to-top > .ic { width: var(--tool-button-size); height: var(--tool-button-size); }
  #tool#tool .contents { display: none !important; }
  #tool#tool button:focus-visible { outline: 2px solid var(--site-accent); outline-offset: -2px; }
  .nyx-player.panel {
    right: calc(max(.5rem, env(safe-area-inset-right)) + var(--mobile-tool-width) + 12px) !important;
    bottom: unquote('max(.75rem, env(safe-area-inset-bottom))') !important;
    width: calc(100vw - 1.5rem) !important; max-width: 420px;
    max-height: calc((100dvh - 2rem) / .82); overflow-y: auto;
    scale: .82; transform-origin: bottom right;
    transition: bottom .3s cubic-bezier(.22, 1, .36, 1), right .3s cubic-bezier(.22, 1, .36, 1), scale .3s cubic-bezier(.22, 1, .36, 1);
  }
  .nyx-player.panel.mobile-above {
    right: .75rem !important; bottom: var(--player-above-bottom) !important;
    scale: 1;
  }
  .nyx-player.panel .preview { flex-direction: row; padding: 1.5rem 1rem 0; gap: 1rem; }
  .nyx-player.panel .preview .cover { flex-shrink: 0; }
  .nyx-player.panel .cover .disc { padding: 1rem; }
  .nyx-player.panel .cover-blur-in { width: 4rem; height: 4rem; }
  .nyx-player.panel .nyx-song-list { max-height: 10rem; }
  .nyx-player.panel .nyx-visualizer { max-width: 100%; }
  .nyx-player.panel .cover img, .nyx-player.panel .cover-placeholder { width: 4rem; height: 4rem; }
  .nyx-player.panel .cover::before { width: 2.3rem; height: 3.5rem; top: -1rem; left: -1rem; }
}
@media(max-width:991px) and (prefers-reduced-motion:reduce) {
  #tool#tool > *, #tool#tool .player button, .nyx-player.panel { transition: none !important; }
}

@media(max-width:991px) and (pointer:coarse) {
  :root { --mobile-tool-width: 48px; --tool-button-size: 42px; }
  #tool#tool { padding: 2px; }
}
