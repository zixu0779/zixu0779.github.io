.friend-application {
  svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; vertical-align: middle; }
  .friend-apply-icon { display: inline-flex; padding: .65rem; border-radius: .75rem; margin-right: .75rem; color: var(--primary-color); background: var(--grey-2); }
  .friend-template { padding-right: 3.75rem; }
  .friend-template pre { margin: 0; border: 0; font: inherit; line-height: 1.8; }
