extends _partials/layout.pug
include _mixin/sidebar.pug
include _mixin/comment.pug

block title
    != page.title
block header
    h1(itemprop="name headline")= page.title
block content
    div(class="about-page")
        section(class="about-body page wrap")
            != partial('standalone-post.pug', {post: page, standaloneReward: true})
        section(class="about-steam" aria-label="Steam 游戏档案")
            span(id="about-steam" aria-hidden="true")
            != partial('steam-card.ejs')
        section(id="about-modules" class="about-modules" aria-label="所在地与人格")
            != partial('about-modules.ejs')
        div(id="copyright" class="friend-comment-anchor" aria-hidden="true")
            span.author(hidden)= config.author
            span.link(hidden)= page.permalink
            span.license(hidden)
        +CommentRender
block sidebar
    +sidebarRender(false)
