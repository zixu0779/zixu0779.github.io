if theme.footer.count
    div(class="count")
        span(class="footer-stat" title="中文按字、英文按单词；不含代码、Markdown 标记和网址")
            span(class="stat-icon")
                i(class="ic i-chart-area")
            span= (siteWordCount() >= 1000 ? Math.round(siteWordCount() / 100) / 10 + 'k' : siteWordCount()) + ' 字'
        span(class="post-meta-divider" aria-hidden="true") |
        span(class="footer-stat" title="代码块总行数（含空行、命令、配置和输出）")
            span(class="stat-icon")
                //- Remix Icon code-s-slash-line 4.6.0 (Apache-2.0).
                svg(viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="代码行数")
                    path(d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z")
            span= siteCodeLines(site).toLocaleString('en-US') + ' 行'
        if theme.busuanzi && theme.busuanzi.short && theme.busuanzi.pv.enable
            span(class="post-meta-divider" aria-hidden="true") |
            span(id="busuanzi_short" class="footer-stat" title="本站累计访问次数（PV）")
                span(class="stat-icon")
                    i(class="ic i-eye")
                span(id="busuanzi_value_site_pv")
