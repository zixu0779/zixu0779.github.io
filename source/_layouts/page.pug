extends _partials/layout.pug
include _mixin/sidebar.pug
include _mixin/comment.pug

block title
    if page.type === 'categories'
        != page.language === 'en' ? 'All categories' : __('title.all') + __('title.category')
    else if page.type === 'tags'
        != page.language === 'en' ? 'All tags' : __('title.all') + __('title.tag')
    else if page.type === '404'
        != __('title.not_found')
    else
        != page.title

block header
    h1(itemprop="name headline")
        if page.link
            - var postTitleIcon = '<i class="ic i-link-alt"></i>'
            - var postText = page.title || page.link
            != _url(page.link, postText + postTitleIcon, {class: 'link external', itemprop: 'url'})
        else
            if page.type === 'categories'
                != page.language === 'en' ? 'All categories' : __('title.all') + __('title.category')
            else if page.type === 'tags'
                != page.language === 'en' ? 'All tags' : __('title.all') + __('title.tag')
            else if page.type === '404'
                != __('title.not_found')
            else
                != page.title

block content
    if page.type === 'categories'
        div(class="collapse wrap taxonomy-overview")
            h2(class="item title")
                != _p('counter.categories', site.categories.length)
            != category_directory()
    else if page.type === 'tags'
        div(class="collapse wrap taxonomy-overview")
            h2(class="item title")
                != _p('counter.tag_cloud', site.tags.length)
            div(class="tag cloud")
                each tag in cloud_tags()
                    - var tier = tag.length === 1 ? 1 : tag.length === 2 ? 2 : tag.length <= 4 ? 3 : tag.length <= 6 ? 4 : 5
                    a(href=url_for(tag.path) data-tier=tier)= site_label(tag.name)
                    = ' '
    else
        div(class="page wrap")
            != partial('_partials/post/post.pug', {post: page})
        +CommentRender

block sidebar
    +sidebarRender(true)
